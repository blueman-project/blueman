#!/bin/sh

# Build and run Blueman Next entirely from this checkout. This script never
# installs files or invokes an install target, so the distribution-provided
# Blueman remains untouched.

set -eu

SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUILD_DIR=${BLUEMAN_BUILD_DIR:-build-local}

case "$BUILD_DIR" in
    /*) ;;
    *) BUILD_DIR="$SOURCE_DIR/$BUILD_DIR" ;;
esac

show_help() {
    cat <<'EOF'
Usage: ./blueman-next [launcher option] [--] [blueman-manager options]

Build and run Blueman Next from this checkout without installing it.

Launcher options:
  --build-only  Configure and compile, but do not start the manager
  --no-deps     Do not install missing build/runtime dependencies
  --help        Show this help

Everything after -- is passed to blueman-manager. Set BLUEMAN_BUILD_DIR to
use a different repository-local build directory.

Examples:
  ./blueman-next
  ./blueman-next --build-only
  ./blueman-next -- --loglevel DEBUG
EOF
}

build_only=false
install_dependencies=true
while [ "$#" -gt 0 ]; do
    case "$1" in
        --build-only)
            build_only=true
            shift
            ;;
        --no-deps)
            install_dependencies=false
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

install_apt_dependencies() {
    packages="
        build-essential
        pkg-config
        meson
        ninja-build
        gettext
        cython3
        libglib2.0-dev
        python3-dev
        python-gi-dev
        libbluetooth-dev
        python3-gi
        python3-cairo
        gir1.2-gtk-3.0
        gir1.2-nm-1.0
        iproute2
        bluez
    "
    missing=""

    for package in $packages; do
        if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -q '^installed$'; then
            missing="$missing $package"
        fi
    done

    if [ -z "$missing" ]; then
        return
    fi

    printf 'Installing missing Blueman build/runtime dependencies:%s\n' "$missing"

    if [ "$(id -u)" -eq 0 ]; then
        elevate=""
    elif command -v sudo >/dev/null 2>&1; then
        elevate="sudo"
    else
        printf '%s\n' 'error: sudo is required to install missing dependencies' >&2
        exit 1
    fi

    # Package names are a fixed list maintained with the Ubuntu CI setup.
    $elevate apt-get update
    # shellcheck disable=SC2086
    $elevate apt-get install -y --no-install-recommends $missing
}

if [ "$install_dependencies" = true ]; then
    if command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
        install_apt_dependencies
    else
        printf '%s\n' 'error: automatic dependency installation currently supports Debian/Ubuntu (apt)' >&2
        printf '%s\n' '       install the dependencies in Dependencies.md, then use --no-deps' >&2
        exit 1
    fi
fi

for command in meson python3; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'error: required command not found: %s\n' "$command" >&2
        exit 1
    fi
done

if [ ! -f "$BUILD_DIR/meson-private/coredata.dat" ]; then
    meson setup "$BUILD_DIR" "$SOURCE_DIR" -Druntime_deps_check=false
fi

meson compile -C "$BUILD_DIR"

# Constants.py is generated by Meson at the build root, while source-mode
# imports expect it inside the package. The destination is intentionally
# ignored by Git and is not copied anywhere outside this checkout.
cp "$BUILD_DIR/Constants.py" "$SOURCE_DIR/blueman/Constants.py"

if [ "$build_only" = true ]; then
    printf 'Blueman Next built locally in %s\n' "$BUILD_DIR"
    exit 0
fi

export BLUEMAN_SOURCE=1
export GSETTINGS_SCHEMA_DIR="$BUILD_DIR/data"
export PYTHONPATH="$BUILD_DIR/module:$SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"

exec python3 "$SOURCE_DIR/tools/run-local-manager.py" "$@"
